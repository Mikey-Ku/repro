{
  "name": "@repro/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations, seed and job queue for Repro.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "echo 'db has integration tests only (pnpm test:integration)'",
    "test:integration": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "retention": "tsx src/retention.ts"
  },
  "dependencies": {
    "@repro/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@repro/config": "workspace:*",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

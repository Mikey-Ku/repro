# Copy to .env for local development. Every value here is a placeholder.

# PostgreSQL (docker compose exposes this on localhost:5432)
DATABASE_URL=postgres://repro:repro@localhost:5432/repro

# Ingest API (public ingestion + internal application API)
INGEST_PORT=4000
INGEST_HOST=0.0.0.0
# Shared secret between the web app and the ingest API. Any string works locally.
REPRO_INTERNAL_TOKEN=change-me-local-internal-token
# Maximum accepted batch size after decompression, in bytes
INGEST_MAX_BATCH_BYTES=2000000
LOG_LEVEL=info

# Web dashboard
WEB_PORT=3000
INGEST_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo application (intentionally broken checkout)
DEMO_PORT=4100
DEMO_MODE=broken
DEMO_URL=http://localhost:4100
# Filled in by `pnpm db:seed`; the demo reads it to initialise the SDK.
DEMO_PROJECT_KEY=

# Worker (incident extraction, diagnostics, reproduction runs)
WORKER_POLL_MS=1000
RUN_TIMEOUT_MS=90000

# Optional AI investigator. Leave empty to use the deterministic fake provider.
# Model strings go through Vercel AI Gateway, e.g. anthropic/claude-sonnet-4.5
AI_GATEWAY_API_KEY=
REPRO_AI_MODEL=

# Ingestion requests per minute per key (in-memory limiter). Benchmarks run with this raised.
INGEST_RATE_LIMIT_PER_MINUTE=600

{
  "name": "@repro/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Repro ingestion API and internal application API (Fastify).",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@repro/contracts": "workspace:*",
    "@repro/db": "workspace:*",
    "@repro/diagnostics": "workspace:*",
    "@repro/test-generator": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repro/config": "workspace:*",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

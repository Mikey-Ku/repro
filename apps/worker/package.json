{
  "name": "@repro/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Repro worker: incident extraction, diagnostics and the restricted reproduction runner.",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@playwright/test": "^1.63.0",
    "@repro/contracts": "workspace:*",
    "@repro/db": "workspace:*",
    "@repro/diagnostics": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "typescript": "^5.9.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repro/config": "workspace:*",
    "@repro/test-generator": "workspace:*",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}

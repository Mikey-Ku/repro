{
  "name": "@repro/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Intentionally broken checkout application used to demonstrate Repro end to end.",
  "type": "module",
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs && tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src client",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@repro/browser-sdk": "workspace:*",
    "fastify": "^5.12.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repro/config": "workspace:*",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
